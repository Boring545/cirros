#!/bin/bash

source "${0%/*}/common-functions.sh"

_APT_UPDATED=false
CIRROS_BRANCH="https://git.launchpad.net/~cirros-dev/cirros"
CIRROS_D=""
DEPS=(
    bc
    bison
    build-essential
    grub-common
    git
    dosfstools
    flex
    gdisk
    gettext
    kpartx
    libncurses5-dev
    mtools
    parallel
    python3
    qemu-img
    quilt
    rsync
    texinfo
    unzip
    wget
    xz
)

yum_get() {
    local ret=""
    if [ "$1" != "update" ] && ! $_APT_UPDATED; then
        error "updating yum"
        sudo yum update -y >/dev/null || {
            ret=$?;
            error "failed to update yum [$ret]";
            return $ret;
        }
        _APT_UPDATED=true
    fi
    sudo yum install -y "$@" >/dev/null
}

filter_installed_packages() {
    # write to stdout, a list of packages not installed locally
    local installed_packages
    installed_packages=$(yum list installed "$@" 2>&1)
    echo "$installed_packages" | grep -Eo '^[^ ]+' | grep -vxFf <(echo "$installed_packages" | grep -Eo '^[^ ]+') - |
    awk '{print $1}'
}

yum_install() {
    local needed
    needed=$(filter_installed_packages "$@")
    [ -z "$needed" ] && return 0
    error "installing: $needed"
    yum_get install "$@"
}

dist_id=$(cat /etc/os-release | grep '^ID=' | cut -d'=' -f2) || fail "failed: unable to determine OS ID"
case "$dist_id" in
    *openEuler*) :;;
    *) fail "do not know how to set up $dist_id";;
esac

ver=$(cat /etc/os-release | grep '^VERSION_ID=' | cut -d'=' -f2 | tr -d '"')
[[ "$ver" < "20.03" ]] &&
    fail "building not supported prior to 20.03"

me=$(readlink -f "$0")
myd=$(dirname "$me")

if [ -f "$myd/../fixup-fs" ]; then
    CIRROS_D=$(cd "$myd/.." && pwd)
elif [ -f "$PWD/cirros/fixup-fs" ]; then
    CIRROS_D="$PWD/cirros"
fi

yum_install "${DEPS[@]}"

if [ -z "$CIRROS_D" ]; then
    error "getting $CIRROS_BRANCH to $PWD/cirros"
    git clone "$CIRROS_BRANCH" cirros ||
        fail "failed clone $CIRROS_BRANCH"
    CIRROS_D="$PWD/cirros"
fi

error "set up functional to $CIRROS_D"

# vi: tabstop=4 expandtab
